{
  "name": "cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "slacky": "./bin/slacky.mjs"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/slacky.mjs --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
